# Copy to .env.local for development. Never commit real values.
# All NEXT_PUBLIC_* values are embedded in the static build and are PUBLIC.

# Canonical public origin, no trailing slash. Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact address shown on the Contact page (mailto link). Leave blank to hide.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. Google Analytics 4 measurement ID (G-XXXXXXXXXX). Blank = analytics disabled.
NEXT_PUBLIC_GA_ID=

# Optional. AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Blank = no ad containers rendered.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional. Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GSC_VERIFICATION=
