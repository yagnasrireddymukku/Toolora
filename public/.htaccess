# Toolora: Apache configuration for the static export (Hostinger shared / cloud / VPS with Apache or LiteSpeed).
# Upload this file to the same folder as index.html (usually public_html). See docs/DEPLOYMENT.md.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# HTTPS and canonical host
# Enable SSL in hPanel first, then these rules are safe to keep on.
# To force "www" (or remove it), uncomment ONE of the host blocks and replace example.com.
# The host you choose must match NEXT_PUBLIC_SITE_URL.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force www:
  # RewriteCond %{HTTP_HOST} ^example\.com$ [NC]
  # RewriteRule ^ https://www.example.com%{REQUEST_URI} [L,R=301]

  # Force non-www:
  # RewriteCond %{HTTP_HOST} ^www\.example\.com$ [NC]
  # RewriteRule ^ https://example.com%{REQUEST_URI} [L,R=301]

  # Block dotfiles (except /.well-known/ for SSL and verification files).
  RewriteRule "(^|/)\.(?!well-known/)" - [F,L]
</IfModule>

# ---------------------------------------------------------------------------
# File types. .mjs must be JavaScript or the PDF reader's web worker will not start.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
# The CSP allows inline scripts because the static export embeds its page data inline.
# Google Analytics / AdSense hosts are listed so they work if you enable them.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Only effective over HTTPS. Remove "preload" unless you intend to submit the domain to the preload list.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.googletagmanager.com https://pagead2.googlesyndication.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com https://pagead2.googlesyndication.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; worker-src 'self' blob:; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# ---------------------------------------------------------------------------
# Caching: hashed build files never change, pages should be revalidated.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff2|svg)$">
    <If "%{REQUEST_URI} =~ m#^/_next/static/#">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>
